{
  "name": "react-gantt-calendar",
  "type": "module",
  "version": "0.5.1",
  "types": "./dist/index.d.ts",
  "files": [
    "/dist",
    "/types"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "repository": "git@github.com:yodakaEngineer/react-gantt-calendar.git",
  "author": "yodakaEngineer <engineeryodaka@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "rm -rf dist types && tsc && vite build",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json,css,scss}'",
    "test": "TZ=utc vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@chromatic-com/storybook": "^4.1.1",
    "@storybook/addon-docs": "9.1.13",
    "@storybook/addon-links": "9.1.13",
    "@storybook/react-vite": "9.1.13",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-loader": "^10.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-storybook": "^9.1.13",
    "husky": "^9.1.7",
    "immer": "^10.1.3",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.93.2",
    "storybook": "9.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dayjs": "^1.11.18"
  }
}
